# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/


.superpowers/

# docs/ 는 기본적으로 스크래치. 도메인 정본과 확정 명세만 예외로 추적한다.
# 이 무시 규칙 때문에 2026-04~07 도메인 문서가 전부 main에 못 올라왔었다.
docs/*
!docs/gym-program-notation.md
!docs/specs/
